#!/usr/bin/env php
<?php
# .sw=2

if ($argc > 1)
{
  $keys = array_slice($argv, 1);
}
else
{
  $keys = array('timestamp', 'src', 'dst', 'pgn', 'length', 'data', 'message');
}

$file = fopen('php://stdin', 'r');
if ($file === false)
{ 
  die("Cannot read stdin");
}

fputcsv(STDOUT, $keys, ',', '"', '');

while (($line = fgets($file)) !== false)
{
  $line = rtrim($line);
  $p = json_decode($line, true);
  if (is_array($p))
  {
    if (array_key_exists('timestamp', $p) && array_key_exists('pgn', $p))
    {
      $row = array();
      foreach ($keys as $key)
      {
        if (array_key_exists($key, $p))
        {
          $row[] = $p[$key];
        }
        else if ($key == 'message')
        {
          $row[] = $line;
        }
        else if ($key == 'length' && array_key_exists('data', $p))
        {
          $row[] = strlen($p['data']) / 2;
        }
        else
        {
          $row[] = '';
        }
      }
      if ($row === array(''))
      {
        echo "\"\"\n"; // fputcsv writes a lone empty field as an empty line, which reads back as no fields
      }
      else
      {
        fputcsv(STDOUT, $row, ',', '"', '');
      }
    }
  }
}

?>
